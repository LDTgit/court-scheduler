<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.legal.courtscheduler.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Lista Dosarelor Urmărite" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TableView fx:id="caseTable" prefHeight="400.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
            <TableColumn fx:id="colCaseNumber" prefWidth="250.0" text="Număr dosar"/>
            <TableColumn fx:id="colCourtName" prefWidth="270.0" text="Instanță"/>
        </columns>
    </TableView>
</VBox>
